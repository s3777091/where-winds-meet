# Web
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Go API
WWM_API_ADDR=127.0.0.1:3200
WWM_WEB_ORIGIN=http://localhost:3199
WWM_STATE_FILE=data/local/player-state.json
WWM_SEED_FILE=data/seed/dev-pois.json
WWM_DATA_SOURCE=official
WWM_OFFICIAL_CACHE_FILE=data/local/official-map-cache.json

# Canonical PostgreSQL/PostGIS store. Leave empty to use local JSON persistence.
DATABASE_URL=

# OpenRouter. The key is read only by the Go service.
AI_ANALYSIS_ENABLED=false
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemma-4-26b-a4b-it:free
OPENROUTER_FALLBACK_MODELS=qwen/qwen3.7-flash
WWM_GAME_PATCH=official-live
WWM_KB_VERSION=official-map-v1
